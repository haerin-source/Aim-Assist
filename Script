--[[
    Modern loader + env cloak
]]

repeat
    task.wait()
until game:IsLoaded()-- env cloak (hide executor globals from game callers)
----------------------------------------------------------------do
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer

    local GEN = (getgenv and getgenv()) or _G

    local HookFunction = GEN.hookfunction or hookfunction
    local NewCClosure = GEN.newcclosure or newcclosure
    local CheckCaller = GEN.checkcaller or checkcaller
    local GetCallingScript = GEN.getcallingscript or getcallingscript

    if type(HookFunction) == "function" and type(NewCClosure) == "function" and type(getfenv) == "function" then
        local MARKER = {
            hookfunction = true, hookmetamethod = true, newcclosure = true, clonefunction = true,
            checkcaller = true, getnamecallmethod = true, getcallingscript = true,
            isexecutorclosure = true, isourclosure = true, iscclosure = true, islclosure = true,
            getgc = true, getreg = true, getrawmetatable = true, setreadonly = true, isreadonly = true,
            make_writeable = true, make_readonly = true, getconnections = true, getcallbackvalue = true,
            getscriptclosure = true, getscriptbytecode = true, getsenv = true, getmenv = true,
            getloadedmodules = true, getscripts = true, getrunningscripts = true,
            getconstants = true, getconstant = true, setconstant = true,
            getupvalues = true, getupvalue = true, setupvalue = true,
            getprotos = true, getproto = true, setproto = true,
            getgenv = true, getrenv = true, identifyexecutor = true, getexecutorname = true,
            syn = true, KRNL_LOADED = true, fluxus = true, SENTINEL_LOADED = true,
            readfile = true, writefile = true, appendfile = true, loadfile = true, listfiles = true,
            makefolder = true, delfile = true, delfolder = true, isfile = true, isfolder = true,
            setclipboard = true, toclipboard = true, request = true, http_request = true, httprequest = true,
            WebSocket = true, gethui = true, protect_gui = true, unprotect_gui = true, cloneref = true,
            fireclickdetector = true, fireproximityprompt = true, firetouchinterest = true, firesignal = true,
            gethiddenproperty = true, sethiddenproperty = true, setscriptable = true,
            Drawing = true, queue_on_teleport = true, queueonteleport = true,
        }

        local function callerIsGame()
            if type(GetCallingScript) == "function" then
                local ok, scr = pcall(GetCallingScript)
                if ok and typeof(scr) == "Instance" then
                    return true, scr
                end
            end
            if type(CheckCaller) == "function" then
                local ok, own = pcall(CheckCaller)
                if ok then
                    return not own, nil
                end
            end
            return true, nil
        end

        local function copySanitized(src, selfRef)
            if type(src) ~= "table" then
                return src
            end
            local out = {}
            local k, v = next(src, nil)
            while k ~= nil do
                local hide = (type(k) == "string" and MARKER[k] == true)
                if not hide then
                    if k == "_G" and type(v) == "table" then
                        out[k] = out
                    else
                        out[k] = v
                    end
                end
                k, v = next(src, k)
            end
            if selfRef and src == selfRef then
                out._G = out
            end
            return out
        end

        local OldRawget
        OldRawget = HookFunction(rawget, NewCClosure(function(t, k)
            local gameCaller = callerIsGame()
            if gameCaller and type(k) == "string" and MARKER[k] then
                return nil
            end
            return OldRawget(t, k)
        end))

        local OldGetfenv
        OldGetfenv = HookFunction(getfenv, NewCClosure(function(target)
            local query = target
            if type(target) == "number" then
                query = target + 1
            elseif target == nil then
                query = 2
            end
            local env = OldGetfenv(query)
            local gameCaller = callerIsGame()
            if gameCaller and type(env) == "table" then
                return copySanitized(env, GEN)
            end
            return env
        end))

        local OriginalGetgenv = rawget(GEN, "getgenv")
        local OriginalGetrenv = rawget(GEN, "getrenv")

        if type(OriginalGetgenv) == "function" and OriginalGetgenv ~= getfenv then
            local OldGetgenv
            OldGetgenv = HookFunction(OriginalGetgenv, NewCClosure(function(...)
                local env = OldGetgenv(...)
                if callerIsGame() and type(env) == "table" then
                    return copySanitized(env, GEN)
                end
                return env
            end))
        end

        if type(OriginalGetrenv) == "function" and OriginalGetrenv ~= OriginalGetgenv and OriginalGetrenv ~= getfenv then
            local OldGetrenv
            OldGetrenv = HookFunction(OriginalGetrenv, NewCClosure(function(...)
                local env = OldGetrenv(...)
                if callerIsGame() and type(env) == "table" then
                    return copySanitized(env, GEN)
                end
                return env
            end))
        end

        pcall(function()
            local kickMethod = LocalPlayer.Kick
            if type(kickMethod) == "function" then
                local OldKick
                OldKick = HookFunction(kickMethod, NewCClosure(function(self, ...)
                    if callerIsGame() and self == LocalPlayer then
                        return nil
                    end
                    return OldKick(self, ...)
                end))
            end
        end)
    end
end-- Modern loader
----------------------------------------------------------------local QueueOnTeleport = queue_on_teleport or function() end
local CloneRef = cloneref or function(value) return value end
local Players = CloneRef(game:GetService("Players"))

shared.ModernURL = "https://exploit.plus/"

local ModernFile = {}

function ModernFile.readfile(path)
    if shared.ModernDev and isfile and isfile(path) then
        return readfile(path)
    end
    local body = game:HttpGet(shared.ModernURL .. path)
    if body and body:find("^<!DOCTYPE html>") then
        return nil
    end
    return body
end

function ModernFile.loadfile(path)
    local source
    if shared.ModernDev and isfile and isfile(path) then
        source = readfile(path)
    else
        source = game:HttpGet(shared.ModernURL .. path)
    end
    if not source or source:find("^<!DOCTYPE html>") then
        Players.LocalPlayer:Kick("Network Issue")
        return false
    end
    local result
    xpcall(function()
        result = loadstring(source, path)()
    end, function()
        Players.LocalPlayer:Kick()
    end)
    return result
end

function ModernFile.downloadfile(path)
    if isfile and isfile(path) then
        return path
    end
    local ok, body = pcall(function()
        return game:HttpGet(shared.ModernURL .. path)
    end)
    if not ok then
        error(body)
    end
    writefile(path, body)
    return path
end

function ModernFile.RunOnActors(source)
    if not getactors or not run_on_actor then
        return
    end
    for _, actor in getactors() do
        run_on_actor(actor, source)
    end
end

shared.ModernFile = ModernFile
shared.ModernConfig = {
    PatchFunction = false,
}

if getgenv then
    getgenv().ModernFile = shared.ModernFile
    getgenv().ModernConfig = shared.ModernConfig
end

if makefolder and isfolder and not isfolder("Modern") then
    makefolder("Modern")
end

if shared.ModernLoading then
    return
end
shared.ModernLoading = true

if shared.ModernConfig.PatchFunction then
    local patchPath = "Modern/Library/PatchFunction.lua"
    local patchSource = ModernFile.readfile(patchPath)
    ModernFile.RunOnActors(patchSource)
    ModernFile.loadfile(patchPath)
end

ModernFile.loadfile("Modern/Gui.lua")

local Modern = shared.Modern

ModernFile.loadfile("Modern/Games/Universal.lua")
ModernFile.loadfile("Modern/Games/" .. game.PlaceId .. ".lua")

Modern:Load()

task.spawn(function()
    repeat
        Modern:Save()
        task.wait(10)
    until not Modern.Loaded
end)

shared.ModernLoading = nil

Modern:Notify({
    Text = "Finished Loading",
    Duration = 8,
})
