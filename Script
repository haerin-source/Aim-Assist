local function Toggle(parent, title, get, set)
    local frame = New("Frame", {
        BackgroundColor3 = Color3.fromRGB(30,30,36),
        Size = UDim2.new(1,-20,0,40),
    }, parent)
    New("UICorner", {CornerRadius = UDim.new(0,8)}, frame)

    New("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(12,0),
        Size = UDim2.new(1,-60,1,0),
        Font = Enum.Font.Gotham,
        Text = title,
        TextColor3 = Config.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)

    local btn = New("TextButton", {
        BackgroundColor3 = get() and Config.Accent or Color3.fromRGB(55,55,65),
        Position = UDim2.new(1,-48,0.5,-11),
        Size = UDim2.fromOffset(36,22),
        Text = "",
        AutoButtonColor = false,
    }, frame)
    New("UICorner", {CornerRadius = UDim.new(1,0)}, btn)

    local knob = New("Frame", {
        BackgroundColor3 = Color3.new(1,1,1),
        Position = get() and UDim2.new(1,-18,0.5,-7) or UDim2.fromOffset(4,4),
        Size = UDim2.fromOffset(14,14),
    }, btn)
    New("UICorner", {CornerRadius = UDim.new(1,0)}, knob)

    btn.MouseButton1Click:Connect(function()
        local n = not get()
        set(n)
        btn.BackgroundColor3 = n and Config.Accent or Color3.fromRGB(55,55,65)
        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = n and UDim2.new(1,-18,0.5,-7) or UDim2.fromOffset(4,4)
        }):Play()
    end)
end

local function Slider(parent, title, min, max, get, set)
    local frame = New("Frame", {
        BackgroundColor3 = Color3.fromRGB(30,30,36),
        Size = UDim2.new(1,-20,0,54),
    }, parent)
    New("UICorner", {CornerRadius = UDim.new(0,8)}, frame)

    local label = New("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(12,4),
        Size = UDim2.new(1,-24,0,18),
        Font = Enum.Font.Gotham,
        Text = title .. ": " .. tostring(get()),
        TextColor3 = Config.Text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)

    local bar = New("Frame", {
        BackgroundColor3 = Color3.fromRGB(45,45,55),
        Position = UDim2.fromOffset(12,30),
        Size = UDim2.new(1,-24,0,6),
    }, frame)
    New("UICorner", {CornerRadius = UDim.new(1,0)}, bar)

    local fill = New("Frame", {
        BackgroundColor3 = Config.Accent,
        Size = UDim2.new(math.clamp((get()-min)/(max-min),0,1),0,1,0),
    }, bar)
    New("UICorner", {CornerRadius = UDim.new(1,0)}, fill)

    local hold = false
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            hold = true
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            hold = false
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if hold and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local rel = math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            local val = math.floor(min + (max-min)*rel + 0.5)
            set(val)
            fill.Size = UDim2.new(rel,0,1,0)
            label.Text = title .. ": " .. tostring(val)
        end
    end)
end

